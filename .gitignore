.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Measurement output is regenerated by a documented command. The one run
# that backs the README is committed by path, deliberately and on its own.
# NOTE: `results/*`, not `results/`. Git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so `results/` + `!results/published/`
# silently ignores the published run too -- verified with `git check-ignore`,
# which named `results/` as the matching rule. With `results/*` the directory
# itself is not excluded, only its entries, so the negation takes effect.
results/*
!results/published/
